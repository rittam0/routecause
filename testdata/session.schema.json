{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whyfi.local/schema/session-1.3.0.json",
  "title": "RouteCause DiagnosticSession 1.3.0",
  "type": "object",
  "required": ["schema_version", "id", "configuration", "started_at", "ended_at", "raw_results", "summaries", "evidence", "diagnosis", "limitations"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "id": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "raw_results": {"type": "array", "items": {"$ref": "#/$defs/probeResult"}},
    "summaries": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "diagnosis": {
      "type": "object",
      "required": ["code", "conclusion", "supporting_evidence", "contradicting_evidence", "alternative_explanations"],
      "properties": {
        "code": {"enum": ["no_material_problem_observed", "likely_dns_degradation", "likely_destination_specific_degradation", "device_resource_pressure", "likely_local_wifi_instability", "likely_local_gateway_instability", "likely_upstream_degradation", "unknown"]},
        "conclusion": {"type": "string"},
        "confidence": {"enum": ["moderate"]},
        "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "contradicting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "alternative_explanations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "probeResult": {
      "type": "object",
      "required": ["id", "collector_type", "target", "started_at", "duration_ms", "success"],
      "properties": {
        "id": {"type": "string"}, "collector_type": {"type": "string"}, "target": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"}, "duration_ms": {"type": "number", "minimum": 0}, "success": {"type": "boolean"},
        "transport_success": {"type": "boolean"}, "endpoint_success": {"type": "boolean"}, "http_method": {"enum": ["HEAD", "GET"]},
        "error_category": {"enum": ["timeout", "connection_refused", "dns_error", "tls_error", "http_error", "cancelled", "unsupported", "system_error", "no_adapter", "disconnected", "ambiguous_route", "icmp_unavailable"]},
        "error_message": {"type": "string"}, "values": {"type": "object", "additionalProperties": {"type": "number"}}, "details": {"type": "object", "additionalProperties": {"type": "string"}}, "os_context": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "evidence": {"type": "object", "required": ["id", "statement", "supports", "summary_keys"], "properties": {"id": {"type": "string"}, "statement": {"type": "string"}, "supports": {"type": "boolean"}, "summary_keys": {"type": "array", "items": {"type": "string"}}}}
  }
}
